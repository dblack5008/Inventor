' GROUPED MOUNTING HOLES - v1.7 (countersink 82/100 dropdown + exact seat verification) (Inventor 2027, assembly-level EXTERNAL iLogic rule)
' Uses native part Hole features: one feature and one point sketch per unique hole specification.
' Operates on the part file referenced by the selected plate occurrence. DOES NOT move components.
' Select a planar plate face, select multiple circular edges OR cylindrical mounting-hole faces,
' click FINISH SELECTION & REVIEW to finish (no ESC dependence). Clicked rims stay cyan while selecting.
' Review groups, then commit. Inward direction is VERIFIED by checking that solid
' material is removed at EVERY selected hole center (and flipped if necessary).
' Native progress bars report both review/validation and hole generation.
' Countersink: angle dropdown defaults to 82 degrees (100 available); entered
' seat diameter and angle are reapplied AFTER clearance association and
' VERIFIED again after part recompute. No silent reversion to table defaults.
' Supports native clearance holes, tapped holes, custom holes, and none/counterbore/countersink/spotface seats.
' Group identity is the size, thread, seat, and clearance specification. The group name is not part of it.
' A name change updates the existing feature. A specification change does not, and the rule explains why before cutting.
' Each identity field is its own attribute (Inventor string attributes hold 255 characters). The set is copied with the feature.
' Sketch and feature naming are collision-resistant and non-fatal if Inventor rejects a rename.
' Default recommendations skip odd fastener numbers after #3.
' All numbered fasteners (#5/#7/#9/#11 included) remain available for manual selection.
' IMPORTANT: Diameter presets are editable initial suggestions, NOT queried from Inventor's
' local Clearance.xls. Always use the fastener/PEM manufacturer's installation requirements.
' This is a test-ready first version. First run on a COPY of an assembly and plate.
'
Sub Main()
    Dim app As Inventor.Application = ThisApplication
    Dim aDoc As Inventor.AssemblyDocument = TryCast(app.ActiveDocument, Inventor.AssemblyDocument)
    If aDoc Is Nothing Then
        System.Windows.Forms.MessageBox.Show("Open an .iam assembly before running this rule.", "Grouped Mounting Holes")
        Exit Sub
    End If

    ' Inventor 2027: CommandManager.Pick may ignore ESC. Use event-based
    ' selection with a visible Cancel button instead, including for the plate.
    Dim plateSelector As New MGHInteractionSelector()
    Dim gotFace As Boolean = plateSelector.Run( _
        app, Inventor.SelectionFilterEnum.kPartFacePlanarFilter, _
        "Select Mounting Plate", _
        "Click the flat mounting face of the plate. The rule will automatically continue.", True)
    If Not gotFace OrElse plateSelector.Picked.Count = 0 Then Exit Sub
    Dim faceObj As Object = plateSelector.Picked(0)
    Dim plateFaceProxy As Inventor.FaceProxy = TryCast(faceObj, Inventor.FaceProxy)
    If plateFaceProxy Is Nothing Then
        System.Windows.Forms.MessageBox.Show("Select a planar face belonging to an actual plate part occurrence.")
        Exit Sub
    End If

    Dim plateOcc As Inventor.ComponentOccurrence = plateFaceProxy.ContainingOccurrence
    If TypeOf plateOcc Is Inventor.ComponentOccurrenceProxy Then
        System.Windows.Forms.MessageBox.Show("Version 1 requires the plate to be a TOP-LEVEL part in this assembly (not inside a subassembly).")
        Exit Sub
    End If
    Dim plateDef As Inventor.PartComponentDefinition = TryCast(plateOcc.Definition, Inventor.PartComponentDefinition)
    If plateDef Is Nothing Then
        System.Windows.Forms.MessageBox.Show("The selected plate is not an editable .ipt part.")
        Exit Sub
    End If
    Dim plateDoc As Inventor.PartDocument = TryCast(plateDef.Document, Inventor.PartDocument)
    If plateDoc Is Nothing OrElse Not plateDoc.IsModifiable Then
        System.Windows.Forms.MessageBox.Show("The plate .ipt is not modifiable. Check read-only, library, and active-edit state.")
        Exit Sub
    End If

    Dim plateNativeFace As Inventor.Face = plateFaceProxy.NativeObject
    Dim platePlane As Inventor.Plane = TryCast(plateNativeFace.Geometry, Inventor.Plane)
    Dim plateAssemblyPlane As Inventor.Plane = TryCast(plateFaceProxy.Geometry, Inventor.Plane)
    If platePlane Is Nothing OrElse plateAssemblyPlane Is Nothing Then
        System.Windows.Forms.MessageBox.Show("The selected plate face must be planar.")
        Exit Sub
    End If

    Dim invertPlate As Inventor.Matrix = plateOcc.Transformation.Copy()
    invertPlate.Invert()

    ' Custom labeled options replace misleading Yes / No buttons.
    Dim modeDialog As New MGHModeDialog()
    Dim modeChoice As System.Windows.Forms.DialogResult = modeDialog.ShowDialog()
    modeDialog.Dispose()
    If modeChoice <> System.Windows.Forms.DialogResult.Yes AndAlso _
       modeChoice <> System.Windows.Forms.DialogResult.No Then Exit Sub
    Dim selectEdges As Boolean = (modeChoice = System.Windows.Forms.DialogResult.Yes)
    Dim pickFilter As Inventor.SelectionFilterEnum = If(selectEdges, _
        Inventor.SelectionFilterEnum.kPartEdgeCircularFilter, _
        Inventor.SelectionFilterEnum.kPartFaceCylindricalFilter)

    Dim holeSelector As New MGHInteractionSelector()
    Dim gotHoles As Boolean = holeSelector.Run( _
        app, pickFilter, "Select Component Mounting Holes", _
        "Click each " & If(selectEdges, "circular hole rim", "cylindrical hole wall") & _
        ". When finished, click FINISH SELECTION & REVIEW in the floating palette.", False)
    If Not gotHoles Then Exit Sub

    Dim selected As New System.Collections.Generic.List(Of MountPoint)()
    Dim excluded As New System.Collections.Generic.List(Of String)()
    For Each item As Object In holeSelector.Picked
        Try
            Dim measuredCenter As Inventor.Point = Nothing
            Dim measuredAxis As Inventor.UnitVector = Nothing
            Dim radiusCm As Double = 0
            Dim sourceName As String = ""
            Dim sourceOccurrence As Inventor.ComponentOccurrence = Nothing

            If selectEdges Then
                Dim e As Inventor.EdgeProxy = TryCast(item, Inventor.EdgeProxy)
                If e Is Nothing Then Throw New System.Exception("Not an assembly circular edge.")
                Dim circ As Inventor.Circle = TryCast(e.Geometry, Inventor.Circle)
                If circ Is Nothing Then Throw New System.Exception("Only full circular edges are supported; select the complete hole rim.")
                measuredCenter = circ.Center
                measuredAxis = circ.Normal
                radiusCm = circ.Radius
                sourceOccurrence = e.ContainingOccurrence
            Else
                Dim f As Inventor.FaceProxy = TryCast(item, Inventor.FaceProxy)
                If f Is Nothing Then Throw New System.Exception("Not an assembly cylindrical face.")
                Dim cyl As Inventor.Cylinder = TryCast(f.Geometry, Inventor.Cylinder)
                If cyl Is Nothing Then Throw New System.Exception("Selected face is not cylindrical.")
                measuredCenter = cyl.BasePoint
                measuredAxis = cyl.AxisVector
                radiusCm = cyl.Radius
                sourceOccurrence = f.ContainingOccurrence
            End If
            sourceName = sourceOccurrence.Name
            If sourceOccurrence.Definition.Document.FullFileName = plateDoc.FullFileName Then
                Throw New System.Exception("Source is a face/edge on the plate itself.")
            End If
            If radiusCm <= 0.0 Then Throw New System.Exception("Invalid radius.")
            If System.Math.Abs(measuredAxis.DotProduct(plateAssemblyPlane.Normal)) < 0.9990 Then
                Throw New System.Exception("Hole axis is not perpendicular to the plate (tolerance about 2.6 deg).")
            End If

            ' Geometry of proxies is in assembly space. Transform into *plate-part* space;
            ' never manipulate assembly component position or use camera/view orientation.
            Dim inPlate As Inventor.Point = measuredCenter.Copy()
            inPlate.TransformBy(invertPlate)
            Dim onPlane As Inventor.Point = ProjectToPlane(inPlate, platePlane, app)
            Dim nearest As Inventor.Point = plateNativeFace.GetClosestPointTo(onPlane)
            If nearest.DistanceTo(onPlane) > 0.003 Then ' 0.03 mm, Inventor internal cm
                Throw New System.Exception("Projected center is outside plate face or within an existing opening.")
            End If
            Dim alreadySelected As Boolean = False
            For Each prior As MountPoint In selected
                If prior.Center.DistanceTo(onPlane) < 0.005 Then ' 0.05 mm
                    alreadySelected = True
                    Exit For
                End If
            Next
            If alreadySelected Then Throw New System.Exception("That hole center is already selected.")

            Dim rec As New MountPoint()
            rec.Center = onPlane
            rec.SourceDiameterIn = (radiusCm * 2.0 / 2.54)
            rec.SourceName = sourceName
            selected.Add(rec)
        Catch ex As System.Exception
            excluded.Add("Skipped selection " & (selected.Count + excluded.Count + 1).ToString() & ": " & ex.Message)
        End Try
    Next

    If selected.Count = 0 Then
        System.Windows.Forms.MessageBox.Show("No usable component holes selected." & _
            If(excluded.Count > 0, vbCrLf & String.Join(vbCrLf, excluded.ToArray()), ""), "No changes")
        Exit Sub
    End If

    Dim buckets As New System.Collections.Generic.SortedDictionary(Of String, InputBucket)(System.StringComparer.Ordinal)
    For Each m As MountPoint In selected
        Dim key As String = m.SourceDiameterIn.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)
        If Not buckets.ContainsKey(key) Then
            Dim b As New InputBucket()
            b.SourceKey = key
            b.Screw = GuessFastener(m.SourceDiameterIn)
            b.Fit = "Normal"
            b.Mode = "Clearance"
            b.Seat = "None"
            b.ThreadType = "ANSI Unified Screw Threads"
            b.ThreadDesignation = MGHDefaultThread(b.Screw)
            b.ThreadClass = "2B"
            b.ClearanceStandard = "Ansi Unified Screw Threads"
            b.ClearanceFamily = "Flat Head Machine Screw (100)"
            b.DiameterIn = PresetDiameter(b.Screw, b.Fit)
            b.GroupLabel = "Hole " & b.Screw & " - Normal"
            buckets.Add(key, b)
        End If
        buckets(key).Centers.Add(m.Center)
    Next

    ' Restore saved group names before the review grid is built. The grid's
    ' suggested name is not the feature identity; overwriting a stored name
    ' on every run would discard a rename.
    Dim planeID As String = StablePlaneKey(platePlane)
    Try
        MGHApplyStoredLabels(buckets, plateDef, planeID)
    Catch ex As System.Exception
        System.Windows.Forms.MessageBox.Show("Existing grouped holes could not be read:" & vbCrLf & ex.Message, "Grouped Mounting Holes")
        Exit Sub
    End Try

    Dim review As New HoleReviewForm(buckets)
    review.Text = "Grouped Mounting Holes - " & plateDoc.DisplayName
    Dim outcome As System.Windows.Forms.DialogResult = review.ShowDialog()
    If outcome <> System.Windows.Forms.DialogResult.OK Then Exit Sub

    ' Review and Generate can take a while when many hole positions are checked.
    ' Create a SECOND, clearly labeled progress bar *before* the checks start.
    Dim reviewProgress As Inventor.ProgressBar = Nothing
    Dim reviewOperation As String = "Preparing review"
    Dim desiredGroups As New System.Collections.Generic.SortedDictionary(Of String, OutputGroup)(System.StringComparer.Ordinal)
    Dim preview As New System.Text.StringBuilder()
    Try
        Dim reviewSteps As Integer = 4 + buckets.Count + selected.Count
        reviewProgress = app.CreateProgressBar(False, reviewSteps, "Grouped Mounting Holes - Reviewing / Validating")
        MGHProgressTick(reviewProgress, app, "Collecting selected mounting-hole specifications")
        For Each b As InputBucket In buckets.Values
            reviewOperation = "Validating specification for source Ø" & b.SourceKey
            MGHProgressMessage(reviewProgress, app, reviewOperation)
            If String.IsNullOrWhiteSpace(b.GroupLabel) Then Throw New System.Exception("Group name is required for Ø" & b.SourceKey)
            If b.Mode <> "Threaded" AndAlso (b.DiameterIn <= 0.01 OrElse b.DiameterIn > 2.0) Then
                Throw New System.Exception("Invalid target Ø for source " & b.SourceKey)
            End If
            If b.Mode = "Clearance" Then
                If b.ClearanceStandard.Trim() = "" OrElse b.ClearanceFamily.Trim() = "" Then
                    Throw New System.Exception("Enter Inventor clearance standard and fastener family for " & b.GroupLabel)
                End If
            End If
            If b.Mode = "Threaded" Then
                If b.ThreadType.Trim() = "" OrElse b.ThreadDesignation.Trim() = "" OrElse b.ThreadClass.Trim() = "" Then
                    Throw New System.Exception("Threaded group '" & b.GroupLabel & "' needs a type, designation and internal class.")
                End If
            End If
            If b.Seat <> "None" Then
                If b.SeatDiameterIn <= 0 Then Throw New System.Exception("Enter a seat diameter for " & b.GroupLabel)
                If b.Seat = "Countersink" Then
                    If b.SeatAngleDeg <= 0 OrElse b.SeatAngleDeg >= 180 Then Throw New System.Exception("Countersink angle must be between 0 and 180 degrees.")
                Else
                    If b.SeatDepthIn <= 0 Then Throw New System.Exception("Enter a positive seat depth for " & b.GroupLabel)
                End If
                If b.Mode <> "Threaded" AndAlso b.SeatDiameterIn <= b.DiameterIn Then
                    Throw New System.Exception("Seat Ø must exceed the hole Ø for " & b.GroupLabel)
                End If
            End If
            MGHRequireStorable("Group name", b.GroupLabel)
            MGHRequireStorable("Fastener", b.Screw)
            MGHRequireStorable("Fit", b.Fit)
            MGHRequireStorable("Hole type", b.Mode)
            MGHRequireStorable("Seat", b.Seat)
            MGHRequireStorable("Thread type", b.ThreadType)
            MGHRequireStorable("Thread designation", b.ThreadDesignation)
            MGHRequireStorable("Thread class", b.ThreadClass)
            MGHRequireStorable("Clearance standard", b.ClearanceStandard)
            MGHRequireStorable("Clearance family", b.ClearanceFamily)
            Dim diameterText As String = b.DiameterIn.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture)
            Dim key As String = MGHSpecKeyFromBucket(planeID, b)
            If desiredGroups.ContainsKey(key) AndAlso _
               Not String.Equals(desiredGroups(key).Label, b.GroupLabel.Trim(), System.StringComparison.OrdinalIgnoreCase) Then
                Throw New System.Exception("Two rows use the same hole specification but different group names ('" & _
                    desiredGroups(key).Label & "' and '" & b.GroupLabel.Trim() & "'). " & _
                    "The name is not part of the feature identity. Use one name, or change the specification.")
            End If
            If Not desiredGroups.ContainsKey(key) Then
                Dim g As New OutputGroup()
                g.Key = key
                g.LegacyKey = MGHSizeKey(planeID, b.Screw, b.Fit, diameterText)
                g.PlaneId = planeID
                g.Label = b.GroupLabel.Trim() : g.DiameterIn = b.DiameterIn
                g.Screw = b.Screw : g.Fit = b.Fit : g.Mode = b.Mode : g.Seat = b.Seat
                g.SeatDiameterIn = b.SeatDiameterIn : g.SeatDepthIn = b.SeatDepthIn : g.SeatAngleDeg = b.SeatAngleDeg
                g.ThreadType = b.ThreadType : g.ThreadDesignation = b.ThreadDesignation : g.ThreadClass = b.ThreadClass
                g.ClearanceStandard = b.ClearanceStandard : g.ClearanceFamily = b.ClearanceFamily
                desiredGroups.Add(key, g)
            End If
            For Each p As Inventor.Point In b.Centers
                desiredGroups(key).Centers.Add(p)
            Next
            MGHProgressTick(reviewProgress, app, "Grouped source Ø" & b.SourceKey & " — " & b.Centers.Count.ToString() & " positions")
        Next

        reviewOperation = "Comparing specifications with existing grouped holes"
        MGHProgressMessage(reviewProgress, app, reviewOperation)
        Dim nameNotes As System.Collections.Generic.List(Of String) = MGHDescribeExistingGroups(plateDef, desiredGroups)

        ' Test full seat envelope (NOT only pilot/core hole diameter).
        reviewOperation = "Checking selected face boundaries and hole/seat interference"
        MGHProgressTick(reviewProgress, app, reviewOperation)
        Dim allLocations As New System.Collections.Generic.List(Of Inventor.Point)()
        Dim allRadii As New System.Collections.Generic.List(Of Double)()
        For Each g As OutputGroup In desiredGroups.Values
            Dim effectiveDiameter As Double = g.DiameterIn
            If g.Mode = "Threaded" Then
                ' Use the nominal major diameter from the actual thread designation
                ' as the conservative envelope, not the minor/tap-drill diameter.
                effectiveDiameter = MGHThreadNominalFromDesignation(g.ThreadDesignation)
                If effectiveDiameter <= 0 Then effectiveDiameter = MGHThreadNominalDiameter(g.Screw)
                If effectiveDiameter <= 0 Then
                    Dim designation As String = g.ThreadDesignation.Trim().ToUpperInvariant()
                    If designation.StartsWith("M") Then
                        Dim cap As String = designation.Substring(1).Split("X"c)(0)
                        Dim nominalMm As Double=0
                        If Double.TryParse(cap,System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,nominalMm) Then
                            effectiveDiameter=nominalMm/25.4
                        End If
                    End If
                End If
                If effectiveDiameter <= 0 Then
                    Throw New System.Exception("Cannot validate the pilot hole diameter for custom thread " & g.ThreadDesignation & _
                        ". Choose a nominal screw size or use an M# thread designation.")
                End If
            End If
            If g.Seat <> "None" Then effectiveDiameter = System.Math.Max(effectiveDiameter, g.SeatDiameterIn)
            Dim radius As Double = effectiveDiameter * 2.54 / 2.0
            For Each pos As Inventor.Point In g.Centers
                reviewOperation = "Checking " & g.Label & " — location " & (allLocations.Count + 1).ToString()
                MGHProgressMessage(reviewProgress, app, reviewOperation)
                For Each perimeter As Inventor.Edge In plateNativeFace.Edges
                    Dim onEdge As Inventor.Point = perimeter.GetClosestPointTo(pos)
                    If onEdge.DistanceTo(pos) + 0.0001 < radius Then
                        Throw New System.Exception("Hole/seat '" & g.Label & "' envelope would intersect plate-face boundary or opening.")
                    End If
                Next
                For j As Integer = 0 To allLocations.Count - 1
                    If pos.DistanceTo(allLocations(j)) + 0.0001 < radius + allRadii(j) Then
                        Throw New System.Exception("Two requested hole/seat envelopes overlap. Adjust sizes or locations before continuing.")
                    End If
                Next
                allLocations.Add(pos) : allRadii.Add(radius)
                MGHProgressTick(reviewProgress, app, "Checked " & allLocations.Count.ToString() & "/" & selected.Count.ToString() & " hole/seat envelopes")
            Next
        Next
        reviewOperation = "Building final preview for " & desiredGroups.Count.ToString() & " groups"
        MGHProgressTick(reviewProgress, app, reviewOperation)
        preview.AppendLine("Part: " & plateDoc.DisplayName)
        preview.AppendLine("Input selections: " & selected.Count.ToString())
        preview.AppendLine("Unique output groups: " & desiredGroups.Count.ToString())
        preview.AppendLine()
        For Each g As OutputGroup In desiredGroups.Values
            Dim detail As String = If(g.Mode = "Threaded", g.ThreadDesignation & " / " & g.ThreadClass, _
                "Ø" & g.DiameterIn.ToString("0.0000") & " in")
            Dim seatDetail As String = If(g.Seat = "None", "", " + " & g.Seat & " Ø" & _
                g.SeatDiameterIn.ToString("0.0000") & " in")
            preview.AppendLine(g.Label & "  [" & g.Mode & "] " & detail & seatDetail & _
                "  (" & g.Centers.Count.ToString() & " positions)")
        Next
        preview.AppendLine()
        preview.AppendLine("All pilot holes are THROUGH ALL. Threaded holes use FULL-length model threads.")
        preview.AppendLine("Native standard clearance and thread dimensions come from Inventor's local tables.")
        preview.AppendLine("This modifies the REAL plate .ipt and every assembly occurrence of it.")
        preview.AppendLine("The script does NOT save the part automatically. Make a backup first.")
        If excluded.Count > 0 Then
            preview.AppendLine()
            preview.AppendLine(excluded.Count.ToString() & " selections were skipped:")
            For Each msg As String In excluded
                preview.AppendLine("- " & msg)
            Next
        End If
        If nameNotes.Count > 0 Then
            preview.AppendLine()
            preview.AppendLine("Existing features with this specification:")
            For Each note As String In nameNotes
                preview.AppendLine("- " & note)
            Next
        End If
        preview.AppendLine()
        preview.Append("Verify the specifications, then choose GENERATE HOLES to proceed.")
        MGHProgressTick(reviewProgress, app, "Validation finished — ready for final confirmation")
    Catch ex As System.Exception
        System.Windows.Forms.MessageBox.Show("Review validation failed: " & reviewOperation & vbCrLf & ex.Message, "Grouped Mounting Holes")
        Exit Sub
    Finally
        If reviewProgress IsNot Nothing Then
            Try
                reviewProgress.Close()
            Catch
            End Try
        End If
    End Try

    Dim approval As New MGHGenerateDialog(preview.ToString())
    Dim approvalResult As System.Windows.Forms.DialogResult = approval.ShowDialog()
    approval.Dispose()
    If approvalResult <> System.Windows.Forms.DialogResult.OK Then Exit Sub

    Dim trans As Inventor.Transaction = Nothing
    Dim progress As Inventor.ProgressBar = Nothing
    Dim operationInfo As String = "Starting plate transaction"
    Try
        ' Every tick represents a REAL completed unit of work; no estimated clock times.
        ' Steps: begin, scan, (prepare + finish each group), each selected location,
        ' final recompute, commit.
        Dim progressSteps As Integer = 4 + 2 * desiredGroups.Count
        For Each gg As OutputGroup In desiredGroups.Values
            progressSteps += gg.Centers.Count
        Next
        progress = app.CreateProgressBar(False, progressSteps, "Grouped Mounting Holes - Generating")
        progress.Message = "Opening transaction for " & plateDoc.DisplayName
        trans = app.TransactionManager.StartTransaction(plateDoc, "Generate Grouped Mounting Holes")
        MGHProgressTick(progress, app, "Plate transaction started - checking existing groups")
        Dim holes As Inventor.HoleFeatures = plateDef.Features.HoleFeatures
        Dim featureIndex As MGHFeatureIndex = MGHLoadFeatureIndex(plateDef)
        Dim existing As New System.Collections.Generic.Dictionary(Of String, Inventor.HoleFeature)(System.StringComparer.Ordinal)
        Dim migrateLegacy As New System.Collections.Generic.Dictionary(Of String, Inventor.HoleFeature)(System.StringComparer.Ordinal)
        For Each g As OutputGroup In desiredGroups.Values
            If featureIndex.BySpec.ContainsKey(g.Key) Then
                existing.Add(g.Key, featureIndex.BySpec(g.Key))
            ElseIf g.Mode = "Clearance" AndAlso g.Seat = "None" AndAlso featureIndex.ByV15Size.ContainsKey(g.LegacyKey) Then
                ' V1.5 stored only screw, fit, diameter, and the display name.
                ' Upgrade that feature when the new request is still a plain clearance hole.
                existing.Add(g.Key, featureIndex.ByV15Size(g.LegacyKey))
                migrateLegacy.Add(g.Key, featureIndex.ByV15Size(g.LegacyKey))
            End If
        Next
        MGHProgressTick(progress, app, "Existing groups indexed - preparing " & desiredGroups.Count.ToString() & " size groups")

        ' Prepare every NEW sketch BEFORE cutting: subsequent cuts can change face topology.
        ' For each sketch, derive its +normal from its sketch coordinates and use
        ' SurfaceBody.IsPointInside to verify WHICH DIRECTION ENTERS THE SOLID.
        ' Do NOT assume kNegative is the right direction and do NOT use COM success
        ' as evidence a Hole feature removed material.
        Dim newSketches As New System.Collections.Generic.Dictionary(Of String, Inventor.PlanarSketch)(System.StringComparer.Ordinal)
        Dim newCenters As New System.Collections.Generic.Dictionary(Of String, Inventor.ObjectCollection)(System.StringComparer.Ordinal)
        Dim inwardDirections As New System.Collections.Generic.Dictionary(Of String, Inventor.PartFeatureExtentDirectionEnum)(System.StringComparer.Ordinal)
        Dim interiorTestPoints As New System.Collections.Generic.Dictionary(Of String, System.Collections.Generic.List(Of Inventor.Point))(System.StringComparer.Ordinal)
        Dim flippedGroups As Integer = 0
        Dim renamedGroups As Integer = 0
        Dim namingWarnings As New System.Collections.Generic.List(Of String)()
        Dim skippedDuplicates As Integer = 0
        Dim newPoints As Integer = 0
        Dim updatedGroups As Integer = 0
        Dim newGroups As Integer = 0
        Dim plateBody As Inventor.SurfaceBody = plateNativeFace.SurfaceBody
        Dim preparationIndex As Integer = 0
        For Each g As OutputGroup In desiredGroups.Values
            preparationIndex += 1
            operationInfo = "Preparing group " & preparationIndex.ToString() & "/" & desiredGroups.Count.ToString() & ": " & g.Label
            MGHProgressMessage(progress, app, operationInfo)
            If existing.ContainsKey(g.Key) Then
                Dim feat As Inventor.HoleFeature = existing(g.Key)
                If g.Mode = "Threaded" Then
                    If Not feat.Tapped Then Throw New System.Exception("Existing group should be threaded but is not: " & feat.Name)
                    Dim storedTap As Inventor.HoleTapInfo = TryCast(feat.TapInfo, Inventor.HoleTapInfo)
                    If storedTap Is Nothing OrElse Not String.Equals(storedTap.ThreadDesignation, g.ThreadDesignation, System.StringComparison.OrdinalIgnoreCase) Then
                        Throw New System.Exception("Existing group thread designation differs: " & feat.Name)
                    End If
                ElseIf feat.HoleDiameter IsNot Nothing Then
                    If Not (g.Mode = "Clearance" AndAlso feat.IsClearanceHole) AndAlso _
                       System.Math.Abs(feat.HoleDiameter.Value - g.DiameterIn * 2.54) > 0.0002 Then
                        Throw New System.Exception("Existing group diameter differs: " & feat.Name & ". Check the feature and specifications.")
                    End If
                End If
                If g.Seat = "Countersink" Then MGHEnforceCountersink(feat, g)
                MGHCheckExistingSeat(feat, g)
                Dim pd As Inventor.SketchHolePlacementDefinition = TryCast(feat.PlacementDefinition, Inventor.SketchHolePlacementDefinition)
                If pd Is Nothing Then Throw New System.Exception("Existing matching feature is no longer sketch-based: " & feat.Name)
                Dim existingSketch As Inventor.PlanarSketch = feat.Sketch
                Dim pendingCenters As New System.Collections.Generic.List(Of Inventor.Point)()
                For Each p As Inventor.Point In g.Centers
                    Dim p2 As Inventor.Point2d = existingSketch.ModelToSketchSpace(p)
                    Dim found As Boolean = False
                    For Each sp As Inventor.SketchPoint In pd.HoleCenterPoints
                        If sp.Geometry.DistanceTo(p2) < 0.005 Then
                            found = True
                            Exit For
                        End If
                    Next
                    If Not found Then pendingCenters.Add(p)
                Next
                If pendingCenters.Count > 0 Then
                    operationInfo = "Determining plate interior for existing group: " & g.Label
                    inwardDirections.Add(g.Key, DetermineInwardDirection(existingSketch, plateBody, pendingCenters, app))
                    interiorTestPoints.Add(g.Key, MGHFindInteriorSamples(existingSketch, plateBody, pendingCenters, app))
                Else
                    ' Selected centers belonging to a previous outward-facing feature
                    ' may still have solid material beneath them. Test each center:
                    ' some centers might already be drilled and should be ignored.
                    Dim repairCenters As New System.Collections.Generic.List(Of Inventor.Point)()
                    For Each center As Inventor.Point In g.Centers
                        Try
                            Dim one As New System.Collections.Generic.List(Of Inventor.Point)()
                            one.Add(center)
                            MGHFindInteriorSamples(existingSketch, plateBody, one, app)
                            repairCenters.Add(center)
                        Catch
                            ' This point is already open / has no material to cut.
                        End Try
                    Next
                    If repairCenters.Count > 0 Then
                        inwardDirections.Add(g.Key, DetermineInwardDirection(existingSketch, plateBody, repairCenters, app))
                        interiorTestPoints.Add(g.Key, MGHFindInteriorSamples(existingSketch, plateBody, repairCenters, app))
                    End If
                End If
            Else
                operationInfo = "Creating sketch for group: " & g.Label
                Dim sk As Inventor.PlanarSketch = plateDef.Sketches.Add(plateNativeFace, False)
                newSketches.Add(g.Key, sk)
                newCenters.Add(g.Key, app.TransientObjects.CreateObjectCollection())
                ' Never rename in this preparation loop. On some assemblies
                ' PlanarSketch.Name raises E_FAIL (e.g. name collision).
                operationInfo = "Determining plate interior for new group: " & g.Label
                inwardDirections.Add(g.Key, DetermineInwardDirection(sk, plateBody, g.Centers, app))
                interiorTestPoints.Add(g.Key, MGHFindInteriorSamples(sk, plateBody, g.Centers, app))
            End If
            MGHProgressTick(progress, app, "Prepared group " & preparationIndex.ToString() & "/" & desiredGroups.Count.ToString() & ": " & g.Label)
        Next

        ' Each new specification uses ONE sketch with all its center points,
        ' feeding ONE native part Hole feature.
        Dim generationIndex As Integer = 0
        For Each g As OutputGroup In desiredGroups.Values
            generationIndex += 1
            If existing.ContainsKey(g.Key) Then Continue For
            operationInfo = "Building new group " & generationIndex.ToString() & "/" & desiredGroups.Count.ToString() & ": " & g.Label
            MGHProgressMessage(progress, app, operationInfo)
            Dim sk As Inventor.PlanarSketch = newSketches(g.Key)
            Dim pts As Inventor.ObjectCollection = newCenters(g.Key)
            Dim addedInGroup As Integer = 0
            For Each p As Inventor.Point In g.Centers
                Dim p2 As Inventor.Point2d = sk.ModelToSketchSpace(p)
                Dim sp As Inventor.SketchPoint = sk.SketchPoints.Add(p2, True)
                sk.GeometricConstraints.AddGround(sp)
                pts.Add(sp)
                newPoints += 1
                addedInGroup += 1
                MGHProgressTick(progress, app, "Group " & generationIndex.ToString() & "/" & desiredGroups.Count.ToString() & _
                    ": " & g.Label & " - point " & addedInGroup.ToString() & "/" & g.Centers.Count.ToString())
            Next
            operationInfo = "Drilling and verifying " & g.Label
            MGHProgressMessage(progress, app, operationInfo)
            Dim place As Inventor.SketchHolePlacementDefinition = holes.CreateSketchPlacementDefinition(pts)
            Dim h As Inventor.HoleFeature = MGHCreateGroupedFeature(holes, place, g, inwardDirections(g.Key))
            If h Is Nothing Then Throw New System.Exception("Inventor returned no Hole feature for " & g.Label)
            ' Do NOT trust a successful API call: a feature can face away from the plate.
            operationInfo = "Verifying through-all cut: " & g.Label
            MGHProgressMessage(progress, app, operationInfo)
            If MGHVerifyCutAndFlip(h, plateDoc, plateDef, interiorTestPoints(g.Key), app, progress, g.Label) Then
                flippedGroups += 1
            End If
            operationInfo = "Recording group identity: " & g.Label
            MGHPersistIdentity(h, g, holes, plateDef, sk, namingWarnings)
            newGroups += 1
            MGHProgressTick(progress, app, "New group " & generationIndex.ToString() & "/" & desiredGroups.Count.ToString() & " completed: " & g.Label)
        Next

        ' Extend existing matching groups, and ensure their Through All direction
        ' points INTO the plate at the newly requested hole location.
        generationIndex = 0
        For Each g As OutputGroup In desiredGroups.Values
            generationIndex += 1
            If Not existing.ContainsKey(g.Key) Then Continue For
            operationInfo = "Checking existing group " & generationIndex.ToString() & "/" & desiredGroups.Count.ToString() & ": " & g.Label
            MGHProgressMessage(progress, app, operationInfo)
            Dim h As Inventor.HoleFeature = existing(g.Key)
            Dim ownedSketch As Inventor.PlanarSketch = Nothing
            Try
                ownedSketch = h.Sketch
            Catch
            End Try
            operationInfo = "Recording group identity: " & g.Label
            If MGHPersistIdentity(h, g, holes, plateDef, ownedSketch, namingWarnings) Then renamedGroups += 1
            Dim placement As Inventor.SketchHolePlacementDefinition = CType(h.PlacementDefinition, Inventor.SketchHolePlacementDefinition)
            Dim sk As Inventor.PlanarSketch = h.Sketch
            Dim allPts As Inventor.ObjectCollection = app.TransientObjects.CreateObjectCollection()
            For Each p As Inventor.SketchPoint In placement.HoleCenterPoints
                allPts.Add(p)
            Next
            Dim changed As Boolean = False
            Dim checkedInGroup As Integer = 0
            For Each p As Inventor.Point In g.Centers
                checkedInGroup += 1
                MGHProgressTick(progress, app, "Group " & generationIndex.ToString() & "/" & desiredGroups.Count.ToString() & _
                    ": " & g.Label & " - checking point " & checkedInGroup.ToString() & "/" & g.Centers.Count.ToString())
                Dim p2 As Inventor.Point2d = sk.ModelToSketchSpace(p)
                Dim duplicate As Boolean = False
                For Each existingPoint As Inventor.SketchPoint In placement.HoleCenterPoints
                    If existingPoint.Geometry.DistanceTo(p2) < 0.005 Then
                        duplicate = True
                        Exit For
                    End If
                Next
                If duplicate Then
                    skippedDuplicates += 1
                    Continue For
                End If
                Dim newSp As Inventor.SketchPoint = sk.SketchPoints.Add(p2, True)
                sk.GeometricConstraints.AddGround(newSp)
                allPts.Add(newSp)
                changed = True
                newPoints += 1
            Next
            If changed Then
                placement.HoleCenterPoints = allPts
            End If
            ' If previously generated holes point into empty space, retry the group
            ' even when no new centers were added.
            If changed OrElse interiorTestPoints.ContainsKey(g.Key) Then
                operationInfo = "Verifying / repairing existing group: " & g.Label
                MGHProgressMessage(progress, app, operationInfo)
                h.SetThroughAllExtent(inwardDirections(g.Key))
                If migrateLegacy.ContainsKey(g.Key) Then
                    operationInfo = "Upgrading legacy clearance association: " & g.Label
                    MGHProgressMessage(progress, app, operationInfo)
                    MGHApplyClearanceInfo(holes, h, g)
                End If
                If MGHVerifyCutAndFlip(h, plateDoc, plateDef, interiorTestPoints(g.Key), app, progress, g.Label) Then
                    flippedGroups += 1
                End If
                updatedGroups += 1
            End If
            If migrateLegacy.ContainsKey(g.Key) Then
                If Not h.IsClearanceHole Then
                    MGHApplyClearanceInfo(holes, h, g)
                End If
            End If
            MGHProgressTick(progress, app, "Existing group " & generationIndex.ToString() & "/" & desiredGroups.Count.ToString() & " checked: " & g.Label)
        Next

        operationInfo = "Final validation: recomputing the mounting plate"
        MGHProgressMessage(progress, app, operationInfo)
        If Not plateDoc.Update2(False) Then
            Throw New System.Exception("Inventor reports one or more part features failed to recompute. " & _
                "The transaction will be aborted; inspect the model/feature geometry.")
        End If
        ' Recompute can cause native clearance tables to restore countersink
        ' dimensions. Reject the group if the saved model differs from user input.
        operationInfo = "Confirming countersink diameters and included angles after recompute"
        MGHProgressMessage(progress, app, operationInfo)
        For Each checkFeat As Inventor.HoleFeature In holes
            If checkFeat.AttributeSets.NameIsUsed("MGH_Generator") Then
                Dim checkIdentity As MGHParsedKey = MGHReadIdentity(checkFeat.AttributeSets.Item("MGH_Generator"))
                If checkIdentity IsNot Nothing AndAlso desiredGroups.ContainsKey(checkIdentity.SpecKey) Then
                    Dim requested As OutputGroup = desiredGroups(checkIdentity.SpecKey)
                    If requested.Seat="Countersink" Then MGHAssertCountersink(checkFeat,requested)
                End If
            End If
        Next
        MGHProgressTick(progress, app, "Final model recompute and countersink dimensions passed")
        operationInfo = "Committing the plate transaction"
        MGHProgressMessage(progress, app, operationInfo)
        trans.End()
        trans = Nothing
        MGHProgressTick(progress, app, "Finished - plate transaction committed")
        If progress IsNot Nothing Then
            progress.Close()
            progress = Nothing
        End If
        System.Windows.Forms.MessageBox.Show( _
            "Finished editing " & plateDoc.DisplayName & vbCrLf & _
            "New groups/features: " & newGroups.ToString() & vbCrLf & _
            "Existing groups extended/repaired: " & updatedGroups.ToString() & vbCrLf & _
            "Group names updated: " & renamedGroups.ToString() & vbCrLf & _
            "Groups whose cut direction was reversed: " & flippedGroups.ToString() & vbCrLf & _
            "New hole centers: " & newPoints.ToString() & vbCrLf & _
            "Duplicate centers skipped: " & skippedDuplicates.ToString() & vbCrLf & _
            If(namingWarnings.Count = 0, "", vbCrLf & "Naming notes (geometry was created):" & vbCrLf & _
                String.Join(vbCrLf, namingWarnings.ToArray()) & vbCrLf) & vbCrLf & _
            "Inspect the plate, dimensions, and hardware clearances, then SAVE the plate .ipt and assembly.", _
            "Grouped Mounting Holes")
    Catch ex As System.Exception
        If progress IsNot Nothing Then
            Try
                progress.Close()
            Catch
            End Try
            progress = Nothing
        End If
        If trans IsNot Nothing Then
            Try
                trans.Abort()
            Catch
            End Try
        End If
        System.Windows.Forms.MessageBox.Show( _
            "Hole creation failed; attempted to roll back the group transaction." & vbCrLf & _
            "Operation: " & operationInfo & vbCrLf & vbCrLf & _
            ex.ToString(), "Grouped Mounting Holes - error")
    End Try
End Sub


' ================================================================
' INVENTOR 2027 INTERACTIVE SELECTION
' InteractionEvents, unlike CommandManager.Pick, provides an explicit
' Finish Selection / Cancel workflow without depending on ESC.
' Autodesk API: InteractionEvents.SelectEvents.OnSelect.
' ================================================================
Public Class MGHInteractionSelector
    Private WithEvents oInteraction As Inventor.InteractionEvents
    Private WithEvents oSelect As Inventor.SelectEvents
    Private palette As MGHSelectionPalette
    Private completed As Boolean
    Private approved As Boolean
    Private automaticFinish As Boolean
    Private highlightSet As Inventor.HighlightSet
    Private highlightRims As Boolean
    Public Picked As New System.Collections.Generic.List(Of Object)()

    Public Function Run(app As Inventor.Application, _
                        filter As Inventor.SelectionFilterEnum, _
                        caption As String, instructions As String, _
                        finishAfterFirst As Boolean) As Boolean
        Picked.Clear()
        completed = False
        approved = False
        automaticFinish = finishAfterFirst
        highlightRims = Not finishAfterFirst
        highlightSet = Nothing
        Try
            palette = New MGHSelectionPalette(caption, instructions, finishAfterFirst)
            AddHandler palette.FinishPressed, AddressOf UserFinished
            AddHandler palette.CancelPressed, AddressOf UserCanceled
            AddHandler palette.FormClosed, AddressOf PaletteClosed

            oInteraction = app.CommandManager.CreateInteractionEvents()
            oInteraction.InteractionDisabled = False
            oInteraction.StatusBarText = instructions
            oSelect = oInteraction.SelectEvents
            oSelect.AddSelectionFilter(filter)
            oSelect.SingleSelectEnabled = finishAfterFirst

            ' Keep ALL selected hole rims visibly highlighted during the session.
            ' HighlightSet is supported in assembly documents and works with proxies.
            If highlightRims Then
                Try
                    Dim assyDoc As Inventor.AssemblyDocument = TryCast(app.ActiveDocument, Inventor.AssemblyDocument)
                    If assyDoc IsNot Nothing Then
                        highlightSet = assyDoc.CreateHighlightSet()
                        highlightSet.Color = app.TransientObjects.CreateColor(0, 220, 255)
                    End If
                Catch
                    ' If Inventor cannot highlight a particular document/context,
                    ' selection and hole creation must still work.
                    highlightSet = Nothing
                End Try
            End If

            palette.Show()  ' Modeless: user continues clicking Inventor geometry.
            oInteraction.Start()
            Do While Not completed
                app.UserInterfaceManager.DoEvents()
                ' Maintain message pumping in Inventor's own STA thread.
                System.Threading.Thread.Sleep(12)
            Loop
            Return approved
        Catch ex As System.Exception
            System.Windows.Forms.MessageBox.Show( _
                "Selection could not be completed:" & vbCrLf & ex.Message, _
                "Grouped Mounting Holes - selection error")
            Return False
        Finally
            completed = True
            If oInteraction IsNot Nothing Then
                Try
                    oInteraction.Stop()
                Catch
                End Try
            End If
            oSelect = Nothing
            oInteraction = Nothing
            If highlightSet IsNot Nothing Then
                Try
                    highlightSet.Clear()
                    highlightSet.Delete()
                Catch
                End Try
                highlightSet = Nothing
            End If
            If palette IsNot Nothing Then
                Try
                    palette.Close()
                    palette.Dispose()
                Catch
                End Try
                palette = Nothing
            End If
        End Try
    End Function

    Private Sub SelectedGeometry(JustSelectedEntities As Inventor.ObjectsEnumerator, _
        SelectionDevice As Inventor.SelectionDeviceEnum, _
        ModelPosition As Inventor.Point, ViewPosition As Inventor.Point2d, _
        View As Inventor.View) Handles oSelect.OnSelect
        If completed Then Exit Sub
        ' Use JustSelectedEntities directly: the event can fire before the
        ' SelectedEntities collection is fully refreshed in some versions.
        For Each ent As Object In JustSelectedEntities
            If ent IsNot Nothing Then Picked.Add(ent)
        Next
        RefreshRimHighlight()
        If palette IsNot Nothing Then palette.SetSelectedCount(Picked.Count)
        If automaticFinish AndAlso Picked.Count > 0 Then
            approved = True
            completed = True
        End If
    End Sub

    Private Sub UnselectedGeometry(UnSelectedEntities As Inventor.ObjectsEnumerator, _
        SelectionDevice As Inventor.SelectionDeviceEnum, _
        ModelPosition As Inventor.Point, ViewPosition As Inventor.Point2d, _
        View As Inventor.View) Handles oSelect.OnUnSelect
        If Not completed Then RefreshSelectedEntities()
    End Sub

    Private Sub RefreshSelectedEntities()
        If oSelect Is Nothing Then Exit Sub
        Picked.Clear()
        Try
            For Each ent As Object In oSelect.SelectedEntities
                If ent IsNot Nothing Then Picked.Add(ent)
            Next
        Catch
            ' OnSelect's JustSelectedEntities fallback remains available.
        End Try
        RefreshRimHighlight()
        If palette IsNot Nothing Then palette.SetSelectedCount(Picked.Count)
    End Sub

    Private Sub RefreshRimHighlight()
        If highlightSet Is Nothing Then Exit Sub
        Try
            highlightSet.Clear()
            For Each ent As Object In Picked
                Try
                    Dim face As Inventor.FaceProxy = TryCast(ent, Inventor.FaceProxy)
                    If face Is Nothing Then
                        ' If user selects an edge, highlight that exact rim.
                        highlightSet.AddItem(ent)
                    Else
                        ' If user selects a cylindrical bore wall, highlight
                        ' the circular bounding rims, not the entire bore wall.
                        Dim foundRims As Boolean = False
                        For Each e As Object In face.Edges
                            Try
                                Dim rim As Inventor.EdgeProxy = TryCast(e, Inventor.EdgeProxy)
                                If rim IsNot Nothing AndAlso TypeOf rim.Geometry Is Inventor.Circle Then
                                    highlightSet.AddItem(rim)
                                    foundRims = True
                                End If
                            Catch
                            End Try
                        Next
                        If Not foundRims Then highlightSet.AddItem(face)
                    End If
                Catch
                    ' A single unhighlightable rim must not cancel the tool.
                End Try
            Next
        Catch
        End Try
    End Sub

    Private Sub InteractionTerminated() Handles oInteraction.OnTerminate
        ' Esc or a competing Inventor command should never hang the rule.
        ' Explicit Finish button is the normal way to proceed.
        If Not completed Then
            approved = False
            completed = True
        End If
    End Sub

    Private Sub UserFinished(sender As Object, e As System.EventArgs)
        If Picked.Count = 0 Then
            System.Windows.Forms.MessageBox.Show( _
                "Select at least one mounting hole before finishing, or click Cancel.", _
                "No holes selected")
            Exit Sub
        End If
        approved = True
        completed = True
    End Sub

    Private Sub UserCanceled(sender As Object, e As System.EventArgs)
        approved = False
        completed = True
    End Sub

    Private Sub PaletteClosed(sender As Object, e As System.Windows.Forms.FormClosedEventArgs)
        If Not completed Then
            approved = False
            completed = True
        End If
    End Sub
End Class

Public Class MGHSelectionPalette
    Inherits System.Windows.Forms.Form

    Public Event FinishPressed As System.EventHandler
    Public Event CancelPressed As System.EventHandler
    Private countLabel As System.Windows.Forms.Label

    Public Sub New(caption As String, instructions As String, singlePick As Boolean)
        MyBase.New()
        Me.Text = caption
        Me.Width = 475
        Me.Height = 215
        Me.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen
        Me.FormBorderStyle = System.Windows.Forms.FormBorderStyle.FixedToolWindow
        Me.TopMost = True
        Me.ShowInTaskbar = False
        Me.MaximizeBox = False
        Me.MinimizeBox = False

        Dim directions As New System.Windows.Forms.Label()
        directions.Text = instructions
        directions.Left = 14 : directions.Top = 14
        directions.Width = 440 : directions.Height = 65
        Me.Controls.Add(directions)

        countLabel = New System.Windows.Forms.Label()
        countLabel.Left = 14 : countLabel.Top = 84
        countLabel.Width = 430 : countLabel.Height = 24
        countLabel.Text = "Selected: 0 (cyan = selected hole rim)"
        Me.Controls.Add(countLabel)

        Dim cancelBtn As New System.Windows.Forms.Button()
        cancelBtn.Text = "Cancel Without Changes"
        cancelBtn.Width = 165 : cancelBtn.Left = 14 : cancelBtn.Top = 117
        AddHandler cancelBtn.Click, AddressOf CancelClick
        Me.Controls.Add(cancelBtn)

        If Not singlePick Then
            Dim finishBtn As New System.Windows.Forms.Button()
            finishBtn.Text = "Finish Selection && Review"
            finishBtn.Width = 190 : finishBtn.Left = 265 : finishBtn.Top = 117
            AddHandler finishBtn.Click, AddressOf FinishClick
            Me.Controls.Add(finishBtn)
        End If
        ' Do NOT set Form.AcceptButton or Form.CancelButton: in Inventor
        ' 2027 iLogic those assignments can invoke System.Private.Windows.Core.
    End Sub

    Public Sub SetSelectedCount(n As Integer)
        countLabel.Text = "Selected: " & n.ToString()
    End Sub

    Private Sub FinishClick(sender As Object, e As System.EventArgs)
        RaiseEvent FinishPressed(Me, System.EventArgs.Empty)
    End Sub

    Private Sub CancelClick(sender As Object, e As System.EventArgs)
        RaiseEvent CancelPressed(Me, System.EventArgs.Empty)
    End Sub
End Class

Public Class MGHModeDialog
    Inherits System.Windows.Forms.Form

    Public Sub New()
        MyBase.New()
        Me.Text = "How do you want to select mounting holes?"
        Me.Width = 585 : Me.Height = 245
        Me.FormBorderStyle = System.Windows.Forms.FormBorderStyle.FixedDialog
        Me.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen
        Me.MaximizeBox = False : Me.MinimizeBox = False
        Dim note As New System.Windows.Forms.Label()
        note.Left = 14 : note.Top = 16 : note.Width = 545 : note.Height = 75
        note.Text = "Choose which geometry you will click on the mounted components." & _
            vbCrLf & "You can select many holes, then click FINISH SELECTION & REVIEW."
        Me.Controls.Add(note)

        Dim rim As New System.Windows.Forms.Button()
        rim.Text = "Select Circular Hole Edges"
        rim.Left = 14 : rim.Top = 103 : rim.Width = 255 : rim.Height = 40
        AddHandler rim.Click, AddressOf ChooseRims
        Me.Controls.Add(rim)

        Dim wall As New System.Windows.Forms.Button()
        wall.Text = "Select Cylindrical Hole Faces"
        wall.Left = 284 : wall.Top = 103 : wall.Width = 275 : wall.Height = 40
        AddHandler wall.Click, AddressOf ChooseWalls
        Me.Controls.Add(wall)

        Dim cancel As New System.Windows.Forms.Button()
        cancel.Text = "Cancel Without Changes"
        cancel.Left = 375 : cancel.Top = 154 : cancel.Width = 184 : cancel.Height = 30
        AddHandler cancel.Click, AddressOf ChooseCancel
        Me.Controls.Add(cancel)
    End Sub

    Private Sub ChooseRims(sender As Object, e As System.EventArgs)
        Me.DialogResult = System.Windows.Forms.DialogResult.Yes
        Me.Close()
    End Sub
    Private Sub ChooseWalls(sender As Object, e As System.EventArgs)
        Me.DialogResult = System.Windows.Forms.DialogResult.No
        Me.Close()
    End Sub
    Private Sub ChooseCancel(sender As Object, e As System.EventArgs)
        Me.DialogResult = System.Windows.Forms.DialogResult.Cancel
        Me.Close()
    End Sub
End Class

Public Class MGHGenerateDialog
    Inherits System.Windows.Forms.Form

    Public Sub New(message As String)
        MyBase.New()
        Me.Text = "Verify Mounting Holes Before Generating"
        Me.Width = 660 : Me.Height = 530
        Me.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen
        Me.FormBorderStyle = System.Windows.Forms.FormBorderStyle.Sizable
