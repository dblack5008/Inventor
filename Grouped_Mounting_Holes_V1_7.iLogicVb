        reviewText.Left = 12 : reviewText.Top = 12
        reviewText.Width = 620 : reviewText.Height = 410
        reviewText.Multiline = True
        reviewText.ScrollBars = System.Windows.Forms.ScrollBars.Vertical
        reviewText.ReadOnly = True
        reviewText.Text = message
        reviewText.Anchor = System.Windows.Forms.AnchorStyles.Top Or _
            System.Windows.Forms.AnchorStyles.Bottom Or _
            System.Windows.Forms.AnchorStyles.Left Or System.Windows.Forms.AnchorStyles.Right
        Me.Controls.Add(reviewText)

        Dim goBtn As New System.Windows.Forms.Button()
        goBtn.Text = "Generate Holes"
